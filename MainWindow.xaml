<Window x:Class="WHIPPINMTA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WHIPPINMTA — Crosshair Studio"
        Height="790" Width="1240" MinHeight="700" MinWidth="1050"
        WindowStartupLocation="CenterScreen"
        Background="#FF0B0D12" Foreground="#FFF4F6FB"
        FontFamily="Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <SolidColorBrush x:Key="Panel" Color="#FF121620"/>
        <SolidColorBrush x:Key="Panel2" Color="#FF191F2B"/>
        <SolidColorBrush x:Key="Muted" Color="#FF8993A6"/>
        <SolidColorBrush x:Key="Accent" Color="#FFFF4D67"/>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFF4F6FB"/>
            <Setter Property="Background" Value="#FF222A38"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Background" Value="#FF303B4E"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.75"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="bd" Property="Opacity" Value="0.4"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#FF0D1119"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF30394A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FF0D1119"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#FF30394A"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFDCE2ED"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="Margin" Value="0,7,0,14"/>
            <Setter Property="Foreground" Value="#FFFF4D67"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="318"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT CONTROL SIDEBAR -->
        <Border Grid.Column="0" Background="#FF10151F" BorderBrush="#FF222B3A" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <StackPanel Margin="24,24,22,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="11" Background="#FFFF4D67" VerticalAlignment="Center">
                            <TextBlock Text="W" FontSize="22" FontWeight="Black" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="WHIPPINMTA" FontSize="18" FontWeight="Bold" Foreground="White"/>
                            <TextBlock Text="CROSSHAIR STUDIO" FontSize="9" Foreground="#FF8D98AC" FontWeight="Bold"/>
                        </StackPanel>
                    </StackPanel>
                    <Border Height="1" Background="#FF252D3B" Margin="0,20,0,17"/>
                    <TextBlock Text="WORKSPACE  /  SETTINGS" FontSize="9" FontWeight="Bold" Foreground="#FFFF657B" Margin="0,0,0,14"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="22,0,22,18">
                        <TextBlock Text="01  TASARIM" FontSize="10" FontWeight="Bold" Foreground="#FF8E9AAF" Margin="0,0,0,10"/>
                        <TextBlock Text="Hazır crosshair tasarımları" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,9"/>
                        <UniformGrid Columns="3" Rows="2" Margin="0,0,0,21">
                            <Button Content="Classic" Tag="classic" Click="Preset_Click" Margin="3"/>
                            <Button Content="Minimal" Tag="minimal" Click="Preset_Click" Margin="3"/>
                            <Button Content="Dot" Tag="dot" Click="Preset_Click" Margin="3"/>
                            <Button Content="Circle" Tag="circle" Click="Preset_Click" Margin="3"/>
                            <Button Content="Precision" Tag="precision" Click="Preset_Click" Margin="3"/>
                            <Button Content="Cross" Tag="cross" Click="Preset_Click" Margin="3"/>
                        </UniformGrid>

                        <Border Background="#FF171E2A" CornerRadius="11" Padding="13" Margin="0,0,0,20">
                            <StackPanel>
                                <TextBlock Text="PROFİLLERİM" FontSize="10" FontWeight="Bold" Foreground="#FFFF657B" Margin="0,0,0,10"/>
                                <TextBox x:Name="ProfileNameBox" Text="Yeni profil" Margin="0,0,0,8"/>
                                <Button Content="＋  PROFİLİ KAYDET" Click="SaveProfile_Click" Background="#FF293449" Margin="0,0,0,8"/>
                                <ComboBox x:Name="ProfileCombo" Margin="0,0,0,8"/>
                                <Button Content="SEÇİLİ PROFİLİ YÜKLE" Click="LoadProfile_Click" Background="#FF293449" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="YENİDEN ADLANDIR" Click="RenameProfile_Click" Background="#FF293449" Padding="7"/>
                                    <Button Grid.Column="2" Content="PROFİLİ SİL" Click="DeleteProfile_Click" Background="#FF633746" Padding="7"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="02  CROSSHAIR AYARLARI" FontSize="10" FontWeight="Bold" Foreground="#FF8E9AAF" Margin="0,0,0,12"/>
                        <TextBlock Text="Boyut" FontSize="12" FontWeight="SemiBold"/>
                        <Slider x:Name="SizeSlider" Minimum="4" Maximum="40" Value="18" ValueChanged="Setting_Changed"/>
                        <TextBlock Text="Çizgi kalınlığı" FontSize="12" FontWeight="SemiBold"/>
                        <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="6" Value="2" ValueChanged="Setting_Changed"/>
                        <TextBlock Text="Merkez boşluğu" FontSize="12" FontWeight="SemiBold"/>
                        <Slider x:Name="GapSlider" Minimum="0" Maximum="18" Value="5" ValueChanged="Setting_Changed"/>
                        <TextBlock Text="Opaklık" FontSize="12" FontWeight="SemiBold"/>
                        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Value="1" ValueChanged="Setting_Changed"/>

                        <Border Height="1" Background="#FF252D3B" Margin="0,0,0,17"/>
                        <TextBlock Text="03  RENK VE KENARLIK" FontSize="10" FontWeight="Bold" Foreground="#FF8E9AAF" Margin="0,0,0,12"/>
                        <TextBlock Text="Crosshair rengi" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="5" Margin="0,0,0,16">
                            <Button Background="#FFFF4242" Tag="#FFFF4242" Click="Color_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FF39E879" Tag="#FF39E879" Click="Color_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FF42B8FF" Tag="#FF42B8FF" Click="Color_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="Color_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FFFFFF00" Tag="#FFFFFF00" Click="Color_Click" Height="30" Margin="2" Padding="0"/>
                        </UniformGrid>
                        <CheckBox x:Name="OutlineCheck" Content="Dış çizgiyi etkinleştir" IsChecked="True" Click="SettingToggle_Changed"/>
                        <TextBlock Text="Dış çizgi kalınlığı" FontSize="12" FontWeight="SemiBold"/>
                        <Slider x:Name="OutlineThicknessSlider" Minimum="1" Maximum="8" Value="2" ValueChanged="Setting_Changed"/>
                        <TextBlock Text="Dış çizgi rengi" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <UniformGrid Columns="5" Margin="0,0,0,10">
                            <Button Background="#FF000000" Tag="#FF000000" Click="OutlineColor_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="OutlineColor_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FFE34242" Tag="#FFE34242" Click="OutlineColor_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FF39E879" Tag="#FF39E879" Click="OutlineColor_Click" Height="30" Margin="2" Padding="0"/>
                            <Button Background="#FF42B8FF" Tag="#FF42B8FF" Click="OutlineColor_Click" Height="30" Margin="2" Padding="0"/>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="22,12,22,20">
                    <Button Content="AYARLARI KAYDET" Click="Save_Click" Background="#FFFF4D67" FontSize="12" Padding="13" Margin="0,0,0,8"/>
                    <TextBlock x:Name="StatusText" Text="Hazır. Tasarımını oluştur." Foreground="#FF8993A6" FontSize="10" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN WORKSPACE -->
        <Grid Grid.Column="1" Margin="27,23,27,24">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Crosshair tasarım alanı" FontSize="23" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Görünümü canlı izle, konumunu ayarla ve oyun içinde kullan." FontSize="11" Foreground="#FF8993A6" Margin="1,5,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="CheckUpdateButton" Content="GÜNCELLEME DENETLE" Click="CheckUpdate_Click" Background="#FF202938" Margin="0,0,8,0"/>
                        <Button x:Name="InstallUpdateButton" Content="GÜNCELLE" Click="InstallUpdate_Click" Background="#FFFF4D67" Visibility="Collapsed"/>
                    </StackPanel>
                    <TextBlock x:Name="UpdateStatusText" Text="Güncellemeler denetleniyor..." Foreground="#FF8993A6" FontSize="9" TextAlignment="Right" Margin="0,7,2,0"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="#FF121722" CornerRadius="18" BorderBrush="#FF222B3A" BorderThickness="1" Padding="19">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid>
                        <TextBlock Text="CANLI ÖNİZLEME" FontSize="10" FontWeight="Bold" Foreground="#FFFF657B"/>
                        <Border HorizontalAlignment="Right" Background="#FF1B2730" CornerRadius="20" Padding="9,4">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Fill="#FF39E879" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock Text="LIVE PREVIEW" FontSize="9" FontWeight="Bold" Foreground="#FF9EEDB7"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    <Border Grid.Row="1" Background="#FF0A0E15" CornerRadius="13" Margin="0,15,0,15" BorderBrush="#FF263044" BorderThickness="1">
                        <Canvas x:Name="PreviewCanvas" ClipToBounds="True" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp">
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing><DrawingGroup>
                                        <GeometryDrawing Brush="#FF0D121B"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,28,28"/></GeometryDrawing.Geometry></GeometryDrawing>
                                        <GeometryDrawing Brush="#FF172131"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,1,28"/><RectangleGeometry Rect="0,0,28,1"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                    </DrawingGroup></DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                        </Canvas>
                    </Border>
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="KONUM AYARI" FontSize="9" FontWeight="Bold" Foreground="#FF8993A6" Margin="0,0,0,9"/>
                            <DockPanel Margin="0,0,0,5"><TextBlock Text="X" Foreground="#FF8993A6" Width="20" VerticalAlignment="Center"/><Slider x:Name="OffsetXSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed" VerticalAlignment="Center"/><TextBlock x:Name="OffsetXText" Text="0" Foreground="White" Width="45" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                            <DockPanel><TextBlock Text="Y" Foreground="#FF8993A6" Width="20" VerticalAlignment="Center"/><Slider x:Name="OffsetYSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed" VerticalAlignment="Center"/><TextBlock x:Name="OffsetYText" Text="0" Foreground="White" Width="45" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="18,0,0,0">
                            <Button Content="MERKEZE AL" Click="Center_Click" Background="#FF202938" Margin="0,0,0,8"/>
                            <TextBlock Text="Önizlemeyi sürükleyerek de taşıyabilirsin." Foreground="#FF8993A6" FontSize="9" TextWrapping="Wrap" Width="165"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="#FF121722" CornerRadius="12" Padding="15" Margin="0,16,0,0" BorderBrush="#FF222B3A" BorderThickness="1">
                <Grid>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="OYUN İÇİ OVERLAY" FontSize="10" FontWeight="Bold" Foreground="#FFFF657B"/>
                        <TextBlock Text="F8 tuşuyla istediğin an açıp kapat." FontSize="10" Foreground="#FF8993A6" Margin="0,4,0,0"/>
                    </StackPanel>
                    <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                        <CheckBox x:Name="OverlayCheck" Content="Overlay etkin" Checked="Overlay_Changed" Unchecked="Overlay_Changed" Margin="0"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>