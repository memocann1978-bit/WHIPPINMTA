<Window x:Class="WHIPPINMTA.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WHIPPINMTA" Height="650" Width="980" MinHeight="580" MinWidth="850" WindowStartupLocation="CenterScreen" Background="#FF101116" Foreground="#FFF4F4F5" FontFamily="Segoe UI">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,22">
   <StackPanel><TextBlock Text="WHIPPINMTA" FontSize="27" FontWeight="Bold"/><TextBlock Text="CROSSHAIR STUDIO  /  DESKTOP OVERLAY" Foreground="#FF858895" FontSize="10" Margin="1,4,0,0"/></StackPanel>
   <Border DockPanel.Dock="Right" Background="#FF20232B" CornerRadius="14" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="COSMETIC OVERLAY" Foreground="#FFE86A6A" FontSize="10" FontWeight="Bold"/></Border>
  </DockPanel>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="1.1*"/><ColumnDefinition Width="1.4*"/></Grid.ColumnDefinitions>
   <Border Background="#FF17191F" CornerRadius="16" Padding="20" Margin="0,0,12,0">
    <StackPanel>
     <TextBlock Text="CURSOR STUDIO" FontSize="13" FontWeight="Bold" Foreground="#FFE86A6A" Margin="0,0,0,18"/>
     <TextBlock Text="Hazır tasarımlar" Foreground="#FFB8BAC4" Margin="0,0,0,8"/>
     <UniformGrid Columns="3" Rows="2" Margin="0,0,0,20">
      <Button Content="Classic" Tag="classic" Click="Preset_Click" Margin="3" Padding="8" Background="#FF292C35" Foreground="White" BorderThickness="0"/>
      <Button Content="Minimal" Tag="minimal" Click="Preset_Click" Margin="3" Padding="8" Background="#FF292C35" Foreground="White" BorderThickness="0"/>
      <Button Content="Dot" Tag="dot" Click="Preset_Click" Margin="3" Padding="8" Background="#FF292C35" Foreground="White" BorderThickness="0"/>
      <Button Content="Circle" Tag="circle" Click="Preset_Click" Margin="3" Padding="8" Background="#FF292C35" Foreground="White" BorderThickness="0"/>
      <Button Content="Precision" Tag="precision" Click="Preset_Click" Margin="3" Padding="8" Background="#FF292C35" Foreground="White" BorderThickness="0"/>
      <Button Content="Cross" Tag="cross" Click="Preset_Click" Margin="3" Padding="8" Background="#FF292C35" Foreground="White" BorderThickness="0"/>
     </UniformGrid>
     <TextBlock Text="Boyut" Foreground="#FFB8BAC4"/><Slider x:Name="SizeSlider" Minimum="4" Maximum="40" Value="18" ValueChanged="Setting_Changed" Margin="0,4,0,14"/>
     <TextBlock Text="Çizgi kalınlığı" Foreground="#FFB8BAC4"/><Slider x:Name="ThicknessSlider" Minimum="1" Maximum="6" Value="2" ValueChanged="Setting_Changed" Margin="0,4,0,14"/>
     <TextBlock Text="Merkez boşluğu" Foreground="#FFB8BAC4"/><Slider x:Name="GapSlider" Minimum="0" Maximum="18" Value="5" ValueChanged="Setting_Changed" Margin="0,4,0,14"/>
     <TextBlock Text="Renk" Foreground="#FFB8BAC4" Margin="0,0,0,8"/>
     <UniformGrid Columns="5">
      <Button Background="#FFFF4242" Tag="#FFFF4242" Click="Color_Click" Height="28" Margin="2"/>
      <Button Background="#FF39E879" Tag="#FF39E879" Click="Color_Click" Height="28" Margin="2"/>
      <Button Background="#FF42B8FF" Tag="#FF42B8FF" Click="Color_Click" Height="28" Margin="2"/>
      <Button Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="Color_Click" Height="28" Margin="2"/>
      <Button Background="#FFFFFF00" Tag="#FFFFFF00" Click="Color_Click" Height="28" Margin="2"/>
     </UniformGrid>
    </StackPanel>
   </Border>
   <Border Grid.Column="1" Background="#FF17191F" CornerRadius="16" Padding="20" Margin="12,0,0,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel><TextBlock Text="CANLI ÖNİZLEME" FontSize="13" FontWeight="Bold" Foreground="#FFE86A6A"/><TextBlock Text="PREVIEW" DockPanel.Dock="Right" Foreground="#FF777B87" FontSize="10"/></DockPanel>
     <Border Grid.Row="1" Background="#FF0D0F13" CornerRadius="12" Margin="0,16,0,16">
      <Canvas x:Name="PreviewCanvas" ClipToBounds="True" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp"><Canvas.Background><DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"><DrawingBrush.Drawing><GeometryDrawing Brush="#FF11141A"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,24,24"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingBrush.Drawing></DrawingBrush></Canvas.Background></Canvas>
     </Border>
     <StackPanel Grid.Row="2">
      <TextBlock Text="Konum (X / Y)" Foreground="#FFB8BAC4" Margin="0,0,0,4"/>
      <DockPanel Margin="0,0,0,2"><TextBlock Text="Yatay" Foreground="#FF858895" Width="48"/><Slider x:Name="OffsetXSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed" VerticalAlignment="Center"/><TextBlock x:Name="OffsetXText" Text="0" Foreground="#FFE5E5E8" Width="42" TextAlignment="Right"/></DockPanel>
      <DockPanel Margin="0,0,0,8"><TextBlock Text="Dikey" Foreground="#FF858895" Width="48"/><Slider x:Name="OffsetYSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed" VerticalAlignment="Center"/><TextBlock x:Name="OffsetYText" Text="0" Foreground="#FFE5E5E8" Width="42" TextAlignment="Right"/></DockPanel>
      <Button Content="MERKEZE AL" Click="Center_Click" Padding="7" Background="#FF292C35" Foreground="White" BorderThickness="0" Margin="0,0,0,10"/>
      <CheckBox x:Name="OverlayCheck" Content="Masaüstü overlay'ini etkinleştir" Foreground="#FFE5E5E8" Checked="Overlay_Changed" Unchecked="Overlay_Changed" Margin="0,0,0,14"/>
      <Button Content="AYARLARI KAYDET" Click="Save_Click" Padding="12" Background="#FFE34242" Foreground="White" FontWeight="Bold" BorderThickness="0" Margin="0,0,0,8"/>
      <TextBlock x:Name="StatusText" Text="Hazır. Tasarımını seç ve önizle." Foreground="#FF858895" FontSize="11" TextWrapping="Wrap"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>