<Window x:Class="WHIPPINMTA.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WHIPPINMTA" Height="700" Width="1360" MinHeight="620" MinWidth="1120"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
 Background="#FF070912" Foreground="#FFF4F6FB" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Red" Color="#FFFF101C"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#FFF5F6FA"/><Setter Property="Background" Value="#FF111827"/>
   <Setter Property="BorderBrush" Value="#FF29334A"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,8"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF35151D"/><Setter TargetName="b" Property="BorderBrush" Value="#FFFF2638"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#FF090D18"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF29334A"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="8,6"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#FF090D18"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF29334A"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFDCE2ED"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,2,0,4"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,0,0,5"/><Setter Property="Foreground" Value="#FFFF101C"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <!-- custom title bar -->
  <Grid Grid.Row="0" Background="#FF080A12" MouseLeftButtonDown="TitleBar_MouseDown">
   <Canvas IsHitTestVisible="False" ClipToBounds="True">
    <Polygon Points="650,0 676,0 644,34 618,34" Fill="#FF310A12"/>
    <Polygon Points="680,0 704,0 672,34 648,34" Fill="#FF5A0B18"/>
    <Polygon Points="704,0 716,0 684,34 672,34" Fill="#FF240A12"/>
   </Canvas>
   <TextBlock Text="WHIPPINMTA  /  CROSSHAIR STUDIO" FontSize="10" FontWeight="Bold" Foreground="#FF8D94A6" VerticalAlignment="Center" Margin="15,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="⚙" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#FFFF2638" Click="CheckUpdate_Click"/>
    <Button Content="—" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Click="MinimizeWindow_Click"/>
    <Button Content="□" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Click="MaximizeWindow_Click"/>
    <Button Content="×" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Click="CloseWindow_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="176"/><ColumnDefinition Width="370"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <!-- LEFT BRAND NAVIGATION -->
   <Border Grid.Column="0" Background="#FF090B13" BorderBrush="#FF29202A" BorderThickness="0,0,1,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="12,19,12,18">
      <TextBlock Text="W" FontSize="48" FontWeight="Black" Foreground="#FFFF101C" HorizontalAlignment="Center" LineHeight="48"/>
      <TextBlock Text="WHIPPINMTA" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,-3,0,0"/>
      <TextBlock Text="Aim. Control. Dominate." FontSize="8" Foreground="#FFFF3C4A" HorizontalAlignment="Center" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="0,4,0,0">
      <Button Content="⌂   Ana Sayfa" Background="#FF850A17" BorderBrush="#FFFF1728" HorizontalContentAlignment="Left" Padding="13,10" Margin="0,0,5,5" CornerRadius="0"/>
      <Button Content="⌖   Crosshair" HorizontalContentAlignment="Left" Padding="13,9" Margin="0,0,5,2" Click="Preset_Click" Tag="classic" Background="Transparent" BorderThickness="0"/>
      <Button Content="♙   Profil Yönetimi" HorizontalContentAlignment="Left" Padding="13,9" Margin="0,0,5,2" Click="LoadProfile_Click" Background="Transparent" BorderThickness="0"/>
      <Button Content="▣   Kısayol Ayarları" HorizontalContentAlignment="Left" Padding="13,9" Margin="0,0,5,2" Click="ApplyHotkey_Click" Background="Transparent" BorderThickness="0"/>
      <Button Content="⚙   Görünüm" HorizontalContentAlignment="Left" Padding="13,9" Margin="0,0,5,2" Click="Save_Click" Background="Transparent" BorderThickness="0"/>
      <Button Content="ⓘ   Hakkında" HorizontalContentAlignment="Left" Padding="13,9" Margin="0,0,5,2" Click="CheckUpdate_Click" Background="Transparent" BorderThickness="0"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Margin="13,12,10,13">
      <TextBlock Text="v1.0.0  •  Build #35" Foreground="#FF8991A4" FontSize="9"/>
      <TextBlock x:Name="StatusText" Text="Hazır." Foreground="#FF8991A4" FontSize="8" TextWrapping="Wrap" Margin="0,5,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <!-- CENTER SETTINGS -->
   <Border Grid.Column="1" Background="#FF0A0D17" BorderBrush="#FF29202A" BorderThickness="0,0,1,0">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="17,16,15,14">
      <TextBlock Text="Crosshair Ayarları" FontSize="16" FontWeight="Bold" Foreground="White"/>
      <TextBlock Text="Oyun içi crosshair görünümünü özelleştir." FontSize="9" Foreground="#FF9AA4B7" Margin="0,3,0,13"/>
      <TextBlock Text="Crosshair Rengi" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="CustomColorBox" Text="#FFFF0000" MaxLength="9" VerticalContentAlignment="Center" FontSize="9"/>
       <Button Grid.Column="1" Content="◉" Click="ApplyCustomColor_Click" Background="#FF171D2B" Margin="5,0,0,0" Padding="8,4"/>
      </Grid>
      <UniformGrid Columns="5" Margin="0,0,0,8">
       <Button Background="#FFFF0000" Tag="#FFFF0000" Click="Color_Click" Height="20" Margin="2" Padding="0"/>
       <Button Background="#FF39E879" Tag="#FF39E879" Click="Color_Click" Height="20" Margin="2" Padding="0"/>
       <Button Background="#FF42B8FF" Tag="#FF42B8FF" Click="Color_Click" Height="20" Margin="2" Padding="0"/>
       <Button Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="Color_Click" Height="20" Margin="2" Padding="0"/>
       <Button Background="#FFFFFF00" Tag="#FFFFFF00" Click="Color_Click" Height="20" Margin="2" Padding="0"/>
      </UniformGrid>
      <TextBlock Text="Dış Çizgi Rengi" FontSize="9" FontWeight="SemiBold" Margin="0,0,0,4"/>
      <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox x:Name="CustomOutlineColorBox" Text="#FFFFFFFF" MaxLength="9" FontSize="9"/>
       <Button Grid.Column="1" Content="●" Click="ApplyCustomOutlineColor_Click" Background="#FF171D2B" Margin="5,0,0,0" Padding="8,4"/>
      </Grid>
      <UniformGrid Columns="5" Margin="0,0,0,8">
       <Button Background="#FF000000" Tag="#FF000000" Click="OutlineColor_Click" Height="18" Margin="2" Padding="0"/>
       <Button Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="OutlineColor_Click" Height="18" Margin="2" Padding="0"/>
       <Button Background="#FFE34242" Tag="#FFE34242" Click="OutlineColor_Click" Height="18" Margin="2" Padding="0"/>
       <Button Background="#FF39E879" Tag="#FF39E879" Click="OutlineColor_Click" Height="18" Margin="2" Padding="0"/>
       <Button Background="#FF42B8FF" Tag="#FF42B8FF" Click="OutlineColor_Click" Height="18" Margin="2" Padding="0"/>
      </UniformGrid>
      <Separator Background="#FF262B3A" Margin="0,3,0,8"/>
      <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Boyut" FontSize="10"/><TextBlock Text="{Binding ElementName=SizeSlider,Path=Value,StringFormat=F0}" Foreground="White" FontSize="9" Grid.Column="1"/></Grid>
      <Slider x:Name="SizeSlider" Minimum="4" Maximum="40" Value="14" ValueChanged="Setting_Changed"/>
      <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Kalınlık" FontSize="10"/><TextBlock Text="{Binding ElementName=ThicknessSlider,Path=Value,StringFormat=F0}" FontSize="9" Grid.Column="1"/></Grid>
      <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="6" Value="2" ValueChanged="Setting_Changed"/>
      <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Boşluk" FontSize="10"/><TextBlock Text="{Binding ElementName=GapSlider,Path=Value,StringFormat=F0}" FontSize="9" Grid.Column="1"/></Grid>
      <Slider x:Name="GapSlider" Minimum="0" Maximum="18" Value="6" ValueChanged="Setting_Changed"/>
      <Grid Margin="0,0,0,3"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Opaklık" FontSize="10"/><TextBlock Text="{Binding ElementName=OpacitySlider,Path=Value,StringFormat={}{0:P0}}" FontSize="9" Grid.Column="1"/></Grid>
      <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Value="1" ValueChanged="Setting_Changed"/>
      <Expander Header="GELİŞMİŞ CROSSHAIR AYARLARI" Foreground="#FFFF5367" FontSize="9" FontWeight="Bold" Margin="0,8,0,0">
       <StackPanel Margin="0,8,0,0">
        <TextBlock Text="Hazır tasarımlar" FontSize="10"/>
        <UniformGrid Columns="3" Margin="0,4,0,8">
         <Button Content="Classic" Tag="classic" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Minimal" Tag="minimal" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Dot" Tag="dot" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Circle" Tag="circle" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Precision" Tag="precision" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Cross" Tag="cross" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="T-Shape" Tag="tshape" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Chevron" Tag="chevron" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Diamond" Tag="diamond" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Square" Tag="square" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Brackets" Tag="brackets" Click="Preset_Click" Margin="2" Padding="5"/>
         <Button Content="Star" Tag="star" Click="Preset_Click" Margin="2" Padding="5"/>
        </UniformGrid>
        <TextBlock Text="Kol uzunlukları" FontSize="10" FontWeight="SemiBold"/>
        <TextBlock Text="Sol" FontSize="9"/><Slider x:Name="LeftLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Sağ" FontSize="9"/><Slider x:Name="RightLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Üst" FontSize="9"/><Slider x:Name="TopLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Alt" FontSize="9"/><Slider x:Name="BottomLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <Button Content="KOLLARI EŞİTLE" Click="EqualizeArms_Click" Margin="0,0,0,7"/>
        <UniformGrid Columns="2">
         <CheckBox x:Name="ShowLeftCheck" Content="Sol kol" IsChecked="True" Click="SettingToggle_Changed"/>
         <CheckBox x:Name="ShowRightCheck" Content="Sağ kol" IsChecked="True" Click="SettingToggle_Changed"/>
         <CheckBox x:Name="ShowTopCheck" Content="Üst kol" IsChecked="True" Click="SettingToggle_Changed"/>
         <CheckBox x:Name="ShowBottomCheck" Content="Alt kol" IsChecked="True" Click="SettingToggle_Changed"/>
        </UniformGrid>
        <CheckBox x:Name="OutlineCheck" Content="Dış çizgiyi etkinleştir" IsChecked="True" Click="SettingToggle_Changed"/>
        <TextBlock Text="Dış çizgi kalınlığı" FontSize="9"/><Slider x:Name="OutlineThicknessSlider" Minimum="1" Maximum="8" Value="2" ValueChanged="Setting_Changed"/>
        <CheckBox x:Name="CenterDotCheck" Content="Merkez noktasını göster" Click="SettingToggle_Changed"/>
        <TextBlock Text="Merkez nokta boyutu" FontSize="9"/><Slider x:Name="CenterDotSizeSlider" Minimum="1" Maximum="12" Value="3" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Açı" FontSize="9"/><Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" Value="0" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Overlay kısayolu" FontSize="10" FontWeight="SemiBold" Margin="0,8,0,4"/>
        <TextBox x:Name="HotkeyBox" Text="F8" IsReadOnly="True" Focusable="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" TextAlignment="Center" FontSize="12" Margin="0,0,0,5"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="6"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Button Content="UYGULA" Click="ApplyHotkey_Click"/><Button Grid.Column="2" Content="VARSAYILAN F8" Click="ResetHotkey_Click"/></Grid>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </Border>
   <!-- RIGHT PREVIEW / PROFILE FOOTER -->
   <Grid Grid.Column="2" Margin="17,16,17,14">
    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Grid.Row="0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid Margin="0,0,0,12">
      <StackPanel><TextBlock Text="Crosshair Önizleme" FontSize="17" FontWeight="Bold"/><TextBlock Text="Gerçek zamanlı görünüm" FontSize="9" Foreground="#FF929BAD" Margin="0,3,0,0"/></StackPanel>
      <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
       <Button x:Name="CheckUpdateButton" Content="GÜNCELLEME DENETLE" Click="CheckUpdate_Click" Padding="9,6" FontSize="9"/>
       <Button x:Name="InstallUpdateButton" Content="GÜNCELLE" Click="InstallUpdate_Click" Background="#FFB5091D" Visibility="Collapsed" Margin="0,4,0,0"/>
       <TextBlock x:Name="UpdateStatusText" Text="Güncellemeler denetleniyor..." Foreground="#FF8993A6" FontSize="8" TextAlignment="Right" Margin="0,4,0,0"/>
      </StackPanel>
     </Grid>
     <Border Grid.Row="1" Background="#FF111321" BorderBrush="#FF343047" BorderThickness="1" CornerRadius="7" ClipToBounds="True">
      <Grid>
       <Grid.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
         <GradientStop Color="#FF3B3045" Offset="0"/><GradientStop Color="#FF24243B" Offset="0.48"/><GradientStop Color="#FF101827" Offset="1"/>
        </LinearGradientBrush>
       </Grid.Background>
       <Canvas IsHitTestVisible="False" ClipToBounds="True">
        <Rectangle Width="700" Height="180" Fill="#22070B16" Canvas.Bottom="0"/>
        <Polygon Points="0,310 0,250 45,215 75,252 105,190 140,240 175,205 210,258 250,210 290,246 330,180 370,230 410,205 450,260 500,190 550,245 600,190 650,260 700,210 700,500 0,500" Fill="#FF101521" Opacity="0.75"/>
        <Ellipse Width="180" Height="180" Fill="#33FF5262" Canvas.Left="260" Canvas.Top="35"/>
       </Canvas>
       <Canvas x:Name="PreviewCanvas" ClipToBounds="True" MouseLeftButtonDown="Preview_MouseDown" MouseMove="Preview_MouseMove" MouseLeftButtonUp="Preview_MouseUp">
        <Canvas.Background><SolidColorBrush Color="#00000000"/></Canvas.Background>
       </Canvas>
      </Grid>
     </Border>
    </Grid>
    <Grid Grid.Row="1" Margin="0,12,0,0">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Grid.Row="0" Margin="0,0,0,9">
      <TextBlock Text="KONUMU SIFIRLA" FontSize="9" Foreground="#FF929BAD" VerticalAlignment="Center"/>
      <Button Content="⌖  Sıfırla" Click="Center_Click" Padding="10,5" HorizontalAlignment="Right"/>
     </DockPanel>
     <Border Grid.Row="1" Background="#FF0D1321" BorderBrush="#FF2B3449" BorderThickness="1" CornerRadius="7" Padding="10">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel>
        <TextBlock Text="X KONUMU" FontSize="8" Foreground="#FF929BAD"/><DockPanel><Slider x:Name="OffsetXSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed"/><TextBlock x:Name="OffsetXText" Text="0" Width="30" FontSize="9" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="Y KONUMU" FontSize="8" Foreground="#FF929BAD"/><DockPanel><Slider x:Name="OffsetYSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed"/><TextBlock x:Name="OffsetYText" Text="0" Width="30" FontSize="9" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
       </StackPanel>
       <CheckBox x:Name="OverlayCheck" Grid.Column="1" Content="Overlay" Checked="Overlay_Changed" Unchecked="Overlay_Changed" VerticalAlignment="Center"/>
       <Button Grid.Column="3" Content="F8  ON / OFF" Padding="11,7" VerticalAlignment="Center" Click="ApplyHotkey_Click"/>
      </Grid>
     </Border>
    </Grid>
    <Border Grid.Row="1" Background="#FF0D1321" BorderBrush="#FF29202A" BorderThickness="1" CornerRadius="7" Padding="9" Margin="0,11,0,0">
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBlock Text="Profil Seçin" FontSize="9" Foreground="#FF929BAD" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <ComboBox x:Name="ProfileCombo" Grid.Column="1" VerticalAlignment="Center" MinWidth="110"/>
      <Button Grid.Column="3" Content="＋" Click="SaveProfile_Click" ToolTip="Profil kaydet" Padding="10,6"/>
      <Button Grid.Column="5" Content="✎" Click="RenameProfile_Click" ToolTip="Profili yeniden adlandır" Padding="10,6"/>
      <Button Grid.Column="7" Content="▤" Click="DeleteProfile_Click" ToolTip="Profili sil" Padding="10,6"/>
      <Button Grid.Column="8" Content="Kaydet" Click="Save_Click" Background="#FFB5091D" BorderBrush="#FFFF2638" Padding="16,8" Margin="8,0,0,0"/>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Grid>
</Window>