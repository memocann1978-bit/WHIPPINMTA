<Window x:Class="WHIPPINMTA.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="WHIPPINMTA" Height="760" Width="1420" MinHeight="680" MinWidth="1160"
 WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResizeWithGrip"
 Background="#FF070912" Foreground="#FFF4F6FB" FontFamily="Segoe UI" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="Red" Color="#FFFF1428"/>
  <SolidColorBrush x:Key="Panel" Color="#FF0D111D"/>
  <SolidColorBrush x:Key="Muted" Color="#FF929BAD"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#FFF5F6FA"/><Setter Property="Background" Value="#FF141A29"/>
   <Setter Property="BorderBrush" Value="#FF30394D"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="11,8"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF32121B"/><Setter TargetName="b" Property="BorderBrush" Value="#FFFF2638"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.72"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#FF090D18"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF30394D"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="9,7"/><Setter Property="CaretBrush" Value="White"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Background" Value="#FF090D18"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#FF30394D"/><Setter Property="Padding" Value="7"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#FFDCE2ED"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,5,0,6"/></Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,2,0,10"/><Setter Property="Foreground" Value="#FFFF1428"/></Style>
  <Style TargetType="TabControl">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl"><ContentPresenter ContentSource="SelectedContent"/></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Foreground" Value="White"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
  <Style x:Key="SectionHint" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="Foreground" Value="#FF929BAD"/><Setter Property="Margin" Value="0,0,0,18"/></Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="10"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="#FFE2E6EF"/><Setter Property="Margin" Value="0,0,0,6"/></Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Grid.Row="0" Background="#FF080A12" MouseLeftButtonDown="TitleBar_MouseDown">
   <Canvas IsHitTestVisible="False" ClipToBounds="True">
    <Polygon Points="650,0 676,0 644,36 618,36" Fill="#FF310A12"/>
    <Polygon Points="680,0 704,0 672,36 648,36" Fill="#FF5A0B18"/>
    <Polygon Points="704,0 716,0 684,36 672,36" Fill="#FF240A12"/>
   </Canvas>
   <TextBlock Text="WHIPPINMTA  /  CROSSHAIR STUDIO" FontSize="10" FontWeight="Bold" Foreground="#FF8D94A6" VerticalAlignment="Center" Margin="16,0"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Content="↻" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Foreground="#FFFF2638" Click="CheckUpdate_Click"/>
    <Button Content="—" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Click="MinimizeWindow_Click"/>
    <Button Content="□" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Click="MaximizeWindow_Click"/>
    <Button Content="×" Width="42" Padding="0" Background="Transparent" BorderThickness="0" Click="CloseWindow_Click"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="390"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Grid.Column="0" Background="#FF090B13" BorderBrush="#FF242A38" BorderThickness="0,0,1,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="14,22,14,25">
      <Border Width="54" Height="54" CornerRadius="15" Background="#FF260D16" BorderBrush="#FFFF2638" BorderThickness="1" HorizontalAlignment="Center">
       <TextBlock Text="W" FontSize="37" FontWeight="Black" Foreground="#FFFF2638" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
      </Border>
      <TextBlock Text="WHIPPINMTA" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" Margin="0,10,0,0"/>
      <TextBlock Text="CROSSHAIR STUDIO" FontSize="8" FontWeight="Bold" Foreground="#FFFF5367" HorizontalAlignment="Center" Margin="0,3,0,0"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="10,0">
      <TextBlock Text="WORKSPACE" FontSize="8" FontWeight="Bold" Foreground="#FF687286" Margin="10,0,0,9"/>
      <Button x:Name="NavHome" Content="⌂    Genel Bakış" Tag="0" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,4" Background="#FF850A17" BorderBrush="#FFFF2638"/>
      <Button x:Name="NavCrosshair" Content="⌖    Crosshair" Tag="1" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,4" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="NavAdvanced" Content="✣    Gelişmiş Ayarlar" Tag="2" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,4" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="NavPosition" Content="⊕    Konum &amp; Overlay" Tag="3" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,4" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="NavHotkeys" Content="⌨    Tuş Kısayolları" Tag="4" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,4" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="NavProfiles" Content="▤    Profil Yönetimi" Tag="5" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,4" Background="Transparent" BorderThickness="0"/>
      <Button x:Name="NavAbout" Content="ⓘ    Hakkında" Tag="6" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="13,11" Margin="0,0,0,4" Background="Transparent" BorderThickness="0"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Margin="14,12,12,16">
      <Border Height="1" Background="#FF252B39" Margin="0,0,0,12"/>
      <TextBlock Text="WHIPPINMTA  •  BUILD" Foreground="#FF687286" FontSize="8" FontWeight="Bold"/>
      <TextBlock Text="Premium Red Edition" Foreground="#FFB7BECC" FontSize="9" Margin="0,4,0,0"/>
      <TextBlock x:Name="StatusText" Text="Hazır." Foreground="#FF8991A4" FontSize="8" TextWrapping="Wrap" Margin="0,7,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="#FF0B0E18" BorderBrush="#FF242A38" BorderThickness="0,0,1,0">
    <TabControl x:Name="SettingsTabs" SelectedIndex="0">
     <TabItem>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="20,22,19,20">
        <TextBlock Text="Genel Bakış" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="WHIPPINMTA kontrol merkezine hoş geldin." Style="{StaticResource SectionHint}"/>
        <Border Background="#FF17101A" BorderBrush="#FF4A1724" BorderThickness="1" CornerRadius="10" Padding="15" Margin="0,0,0,15">
         <StackPanel>
          <TextBlock Text="PREMIUM RED" Foreground="#FFFF5367" FontSize="9" FontWeight="Bold"/>
          <TextBlock Text="Crosshair kontrolü." FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,6,0,3"/>
          <TextBlock Text="Tüm ayarlar artık sol menüde kendi sekmesinde. Bir kategori seçerek düzenlemeye başlayabilirsin." TextWrapping="Wrap" FontSize="10" Foreground="#FFB0B7C5"/>
         </StackPanel>
        </Border>
        <TextBlock Text="HIZLI İŞLEMLER" FontSize="9" FontWeight="Bold" Foreground="#FF737D91" Margin="0,0,0,9"/>
        <Button Content="⌖   Crosshair ayarlarını aç" Tag="1" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="12,12" Margin="0,0,0,8"/>
        <Button Content="⌨   Kısayol ayarlarını aç" Tag="4" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="12,12" Margin="0,0,0,8"/>
        <Button Content="▤   Profillerimi yönet" Tag="5" Click="Navigation_Click" HorizontalContentAlignment="Left" Padding="12,12"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="20,22,19,20">
        <TextBlock Text="Crosshair" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Temel görünüm, renk ve hazır tasarımlar." Style="{StaticResource SectionHint}"/>
        <TextBlock Text="CROSSHAIR RENGİ" Style="{StaticResource FieldLabel}"/>
        <Grid Margin="0,0,0,9"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="CustomColorBox" Text="#FFFF0000" MaxLength="9" VerticalContentAlignment="Center" FontSize="10"/>
         <Button Grid.Column="1" Content="UYGULA" Click="ApplyCustomColor_Click" Margin="7,0,0,0" Padding="12,7"/>
        </Grid>
        <UniformGrid Columns="5" Margin="0,0,0,17">
         <Button Background="#FFFF0000" Tag="#FFFF0000" Click="Color_Click" Height="25" Margin="3" Padding="0"/>
         <Button Background="#FF39E879" Tag="#FF39E879" Click="Color_Click" Height="25" Margin="3" Padding="0"/>
         <Button Background="#FF42B8FF" Tag="#FF42B8FF" Click="Color_Click" Height="25" Margin="3" Padding="0"/>
         <Button Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="Color_Click" Height="25" Margin="3" Padding="0"/>
         <Button Background="#FFFFFF00" Tag="#FFFFFF00" Click="Color_Click" Height="25" Margin="3" Padding="0"/>
        </UniformGrid>
        <TextBlock Text="BOYUT" Style="{StaticResource FieldLabel}"/>
        <Slider x:Name="SizeSlider" Minimum="4" Maximum="40" Value="14" ValueChanged="Setting_Changed"/>
        <TextBlock Text="KALINLIK" Style="{StaticResource FieldLabel}"/>
        <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="6" Value="2" ValueChanged="Setting_Changed"/>
        <TextBlock Text="BOŞLUK" Style="{StaticResource FieldLabel}"/>
        <Slider x:Name="GapSlider" Minimum="0" Maximum="18" Value="6" ValueChanged="Setting_Changed"/>
        <TextBlock Text="OPAKLIK" Style="{StaticResource FieldLabel}"/>
        <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Value="1" ValueChanged="Setting_Changed"/>
        <Border Height="1" Background="#FF252B39" Margin="0,5,0,15"/>
        <TextBlock Text="HAZIR TASARIMLAR" Style="{StaticResource FieldLabel}"/>
        <UniformGrid Columns="3">
         <Button Content="Classic" Tag="classic" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Minimal" Tag="minimal" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Dot" Tag="dot" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Circle" Tag="circle" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Precision" Tag="precision" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Cross" Tag="cross" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="T-Shape" Tag="tshape" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Chevron" Tag="chevron" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Diamond" Tag="diamond" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Square" Tag="square" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Brackets" Tag="brackets" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Star" Tag="star" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="X Cross" Tag="x" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Target" Tag="target" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Ticks" Tag="ticks" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Circle Cross" Tag="circlecross" Click="Preset_Click" Margin="3" Padding="7"/>
         <Button Content="Hollow Dot" Tag="hollowdot" Click="Preset_Click" Margin="3" Padding="7"/>
        </UniformGrid>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="20,22,19,20">
        <TextBlock Text="Gelişmiş Ayarlar" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Crosshair kollarını ve merkez detaylarını ayrı ayrı düzenle." Style="{StaticResource SectionHint}"/>
        <TextBlock Text="KOL UZUNLUKLARI" Style="{StaticResource FieldLabel}"/>
        <TextBlock Text="Sol kol" FontSize="9"/><Slider x:Name="LeftLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Sağ kol" FontSize="9"/><Slider x:Name="RightLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Üst kol" FontSize="9"/><Slider x:Name="TopLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Alt kol" FontSize="9"/><Slider x:Name="BottomLengthSlider" Minimum="0" Maximum="50" Value="18" ValueChanged="Setting_Changed"/>
        <Button Content="KOLLARI EŞİTLE" Click="EqualizeArms_Click" Margin="0,0,0,12"/>
        <UniformGrid Columns="2">
         <CheckBox x:Name="ShowLeftCheck" Content="Sol kolu göster" IsChecked="True" Click="SettingToggle_Changed"/>
         <CheckBox x:Name="ShowRightCheck" Content="Sağ kolu göster" IsChecked="True" Click="SettingToggle_Changed"/>
         <CheckBox x:Name="ShowTopCheck" Content="Üst kolu göster" IsChecked="True" Click="SettingToggle_Changed"/>
         <CheckBox x:Name="ShowBottomCheck" Content="Alt kolu göster" IsChecked="True" Click="SettingToggle_Changed"/>
        </UniformGrid>
        <Border Height="1" Background="#FF252B39" Margin="0,8,0,15"/>
        <TextBlock Text="DIŞ ÇİZGİ" Style="{StaticResource FieldLabel}"/>
        <CheckBox x:Name="OutlineCheck" Content="Dış çizgiyi etkinleştir" IsChecked="True" Click="SettingToggle_Changed"/>
        <TextBlock Text="Dış çizgi rengi" FontSize="9" Margin="0,7,0,5"/>
        <Grid Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBox x:Name="CustomOutlineColorBox" Text="#FFFFFFFF" MaxLength="9" FontSize="10"/>
         <Button Grid.Column="1" Content="UYGULA" Click="ApplyCustomOutlineColor_Click" Margin="7,0,0,0" Padding="12,7"/>
        </Grid>
        <UniformGrid Columns="5" Margin="0,0,0,10">
         <Button Background="#FF000000" Tag="#FF000000" Click="OutlineColor_Click" Height="22" Margin="2" Padding="0"/>
         <Button Background="#FFFFFFFF" Tag="#FFFFFFFF" Click="OutlineColor_Click" Height="22" Margin="2" Padding="0"/>
         <Button Background="#FFE34242" Tag="#FFE34242" Click="OutlineColor_Click" Height="22" Margin="2" Padding="0"/>
         <Button Background="#FF39E879" Tag="#FF39E879" Click="OutlineColor_Click" Height="22" Margin="2" Padding="0"/>
         <Button Background="#FF42B8FF" Tag="#FF42B8FF" Click="OutlineColor_Click" Height="22" Margin="2" Padding="0"/>
        </UniformGrid>
        <TextBlock Text="Dış çizgi kalınlığı" FontSize="9"/><Slider x:Name="OutlineThicknessSlider" Minimum="1" Maximum="8" Value="2" ValueChanged="Setting_Changed"/>
        <Border Height="1" Background="#FF252B39" Margin="0,8,0,15"/>
        <TextBlock Text="MERKEZ NOKTASI &amp; AÇI" Style="{StaticResource FieldLabel}"/>
        <CheckBox x:Name="CenterDotCheck" Content="Merkez noktasını göster" Click="SettingToggle_Changed"/>
        <TextBlock Text="Merkez nokta boyutu" FontSize="9"/><Slider x:Name="CenterDotSizeSlider" Minimum="1" Maximum="12" Value="3" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Döndürme açısı" FontSize="9"/><Slider x:Name="RotationSlider" Minimum="-180" Maximum="180" Value="0" ValueChanged="Setting_Changed"/>
        <Border Height="1" Background="#FF252B39" Margin="0,8,0,15"/>
        <TextBlock Text="GÖRSEL EFEKTLER" Style="{StaticResource FieldLabel}"/>
        <CheckBox x:Name="GlowCheck" Content="Neon parıltı (Glow) efekti" Click="SettingToggle_Changed"/>
        <TextBlock Text="Parıltı yoğunluğu" FontSize="9"/><Slider x:Name="GlowStrengthSlider" Minimum="0" Maximum="30" Value="12" ValueChanged="Setting_Changed"/>
        <CheckBox x:Name="CenterRingCheck" Content="Merkez halkasını göster" Click="SettingToggle_Changed"/>
        <TextBlock Text="Merkez halka çapı" FontSize="9"/><Slider x:Name="CenterRingSizeSlider" Minimum="4" Maximum="60" Value="16" ValueChanged="Setting_Changed"/>
        <Border Height="1" Background="#FF252B39" Margin="0,8,0,15"/>
        <TextBlock Text="RENK ANİMASYONU" Style="{StaticResource FieldLabel}"/>
        <CheckBox x:Name="RainbowCheck" Content="Rainbow renk döngüsünü etkinleştir" Click="Rainbow_Changed"/>
        <TextBlock Text="Renk geçiş hızı" FontSize="9"/><Slider x:Name="RainbowSpeedSlider" Minimum="80" Maximum="1200" Value="350" ValueChanged="Setting_Changed"/>
        <Border Height="1" Background="#FF252B39" Margin="0,8,0,15"/>
        <TextBlock Text="HAREKETLİ CROSSHAIR EFEKTLERİ" Style="{StaticResource FieldLabel}"/>
        <CheckBox x:Name="PulseCheck" Content="Nabız efekti (boyut ritmik büyüyüp küçülür)" Click="SettingToggle_Changed"/>
        <CheckBox x:Name="BlinkCheck" Content="Nefes / parlaklık efekti" Click="SettingToggle_Changed"/>
        <TextBlock Text="Animasyon hızı" FontSize="9"/><Slider x:Name="EffectSpeedSlider" Minimum="20" Maximum="200" Value="100" ValueChanged="Setting_Changed"/>
        <TextBlock Text="Efektler yalnızca görsel animasyondur; hedef takibi veya otomatik nişan içermez." Foreground="#FF929BAD" FontSize="9" TextWrapping="Wrap" Margin="0,6,0,0"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem>
      <StackPanel Margin="20,22,19,20">
       <TextBlock Text="Konum &amp; Overlay" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="Ekrandaki konumu ayarla ve overlay'i yönet." Style="{StaticResource SectionHint}"/>
       <Border Background="#FF111827" BorderBrush="#FF30394D" BorderThickness="1" CornerRadius="9" Padding="14">
        <StackPanel>
         <CheckBox x:Name="OverlayCheck" Content="Crosshair overlay'i etkinleştir" Checked="Overlay_Changed" Unchecked="Overlay_Changed" FontSize="11" FontWeight="SemiBold"/>
         <TextBlock Text="Overlay açıkken crosshair ekranın üzerinde görünür. F8 varsayılan kısayoldur." TextWrapping="Wrap" Foreground="#FF929BAD" FontSize="9" Margin="0,4,0,12"/>
         <TextBlock Text="YATAY KONUM (X)" Style="{StaticResource FieldLabel}"/>
         <DockPanel><Slider x:Name="OffsetXSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed"/><TextBlock x:Name="OffsetXText" Text="0" Width="36" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
         <TextBlock Text="DİKEY KONUM (Y)" Style="{StaticResource FieldLabel}"/>
         <DockPanel><Slider x:Name="OffsetYSlider" Minimum="-500" Maximum="500" Value="0" ValueChanged="Position_Changed"/><TextBlock x:Name="OffsetYText" Text="0" Width="36" FontSize="10" TextAlignment="Right" VerticalAlignment="Center"/></DockPanel>
         <Button Content="⌖   EKRAN MERKEZİNE SIFIRLA" Click="Center_Click" Margin="0,8,0,0"/>
        </StackPanel>
       </Border>
      </StackPanel>
     </TabItem>
     <TabItem>
      <StackPanel Margin="20,22,19,20">
       <TextBlock Text="Tuş Kısayolları" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="Overlay'i istediğin klavye kombinasyonuyla açıp kapat." Style="{StaticResource SectionHint}"/>
       <Border Background="#FF111827" BorderBrush="#FF30394D" BorderThickness="1" CornerRadius="9" Padding="14">
        <StackPanel>
         <TextBlock Text="OVERLAY AÇ / KAPAT" Style="{StaticResource FieldLabel}"/>
         <TextBlock Text="Atamak için kutuya tıkla ve kullanmak istediğin tuşa bas." FontSize="9" Foreground="#FF929BAD" TextWrapping="Wrap" Margin="0,0,0,10"/>
         <TextBox x:Name="HotkeyBox" Text="F8" IsReadOnly="True" Focusable="True" PreviewKeyDown="HotkeyBox_PreviewKeyDown" TextAlignment="Center" FontSize="17" FontWeight="Bold" Padding="12" Margin="0,0,0,12"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
          <Button Content="KISAYOLU UYGULA" Click="ApplyHotkey_Click" Background="#FF8E0D1D" BorderBrush="#FFFF2638"/>
          <Button Grid.Column="2" Content="VARSAYILAN F8" Click="ResetHotkey_Click"/>
         </Grid>
        </StackPanel>
       </Border>
       <TextBlock Text="İPUCU" FontSize="9" FontWeight="Bold" Foreground="#FFFF5367" Margin="0,20,0,6"/>
       <TextBlock Text="Ctrl, Alt, Shift veya Windows tuşlarını ana tuşla birleştirebilirsin. Örnek: Ctrl+F8." FontSize="10" Foreground="#FF929BAD" TextWrapping="Wrap"/>
      </StackPanel>
     </TabItem>
     <TabItem>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="20,22,19,20">
        <TextBlock Text="Profil Yönetimi" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="Ayar kombinasyonlarını kaydet, yeniden adlandır veya paylaş." Style="{StaticResource SectionHint}"/>
        <TextBlock Text="KAYITLI PROFİLLER" Style="{StaticResource FieldLabel}"/>
        <ComboBox x:Name="ProfileCombo" MinHeight="34" Margin="0,0,0,12"/>
        <TextBlock Text="PROFİL ADI" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ProfileNameBox" Text="Yeni profil" Margin="0,0,0,12"/>
        <UniformGrid Columns="2">
         <Button Content="＋  Yeni / Üzerine Kaydet" Click="SaveProfile_Click" Margin="3" Padding="10"/>
         <Button Content="Profili Yükle" Click="LoadProfile_Click" Margin="3" Padding="10" Background="#FF8E0D1D" BorderBrush="#FFFF2638"/>
         <Button Content="✎  Yeniden Adlandır" Click="RenameProfile_Click" Margin="3" Padding="10"/>
         <Button Content="Sil" Click="DeleteProfile_Click" Margin="3" Padding="10"/>
         <Button Content="İçe Aktar" Click="ImportProfile_Click" Margin="3" Padding="10"/>
         <Button Content="Dışa Aktar" Click="ExportProfile_Click" Margin="3" Padding="10"/>
        </UniformGrid>
        <Button Content="Tüm mevcut ayarları kaydet" Click="Save_Click" Margin="3,14,3,0" Background="#FF8E0D1D" BorderBrush="#FFFF2638" Padding="11"/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
     <TabItem>
      <StackPanel Margin="20,22,19,20">
       <TextBlock Text="Hakkında" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="WHIPPINMTA Crosshair Studio" Style="{StaticResource SectionHint}"/>
       <Border Background="#FF111827" BorderBrush="#FF30394D" BorderThickness="1" CornerRadius="9" Padding="14">
        <StackPanel>
